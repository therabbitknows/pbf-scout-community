# Create your own MentraOS app in the Developer Console. Never commit its key.
MENTRAOS_PACKAGE_NAME=com.example.scout
MENTRAOS_API_KEY=replace-with-your-own-key
PORT=3000

# OpenAI-compatible vision endpoint. Examples include a self-hosted gateway,
# Ollama's /v1 endpoint, or a provider account owned by the operator.
SCOUT_VISION_BASE_URL=http://127.0.0.1:11434/v1
SCOUT_VISION_MODEL=replace-with-a-vision-capable-model
SCOUT_VISION_API_KEY=
SCOUT_VISION_TIMEOUT_MS=30000

# Optional user-owned Discord destination. Publishing remains confirmation-gated.
SCOUT_DISCORD_WEBHOOK_URL=
SCOUT_DISCORD_CHANNEL_LABEL=#scout-findings

# Optional read-only generic inventory. Copy examples/inventory.example.json.
SCOUT_INVENTORY_PATH=

# Optional authenticated bridge for the PBF Scout Rabbit Creation. This route
# controls only an active MentraOS session and never accepts an image from R1.
PBF_R1_BRIDGE_TOKEN=replace-with-a-dedicated-r1-token
PBF_R1_ALLOWED_ORIGIN=https://pbf-scout-rabbit-creation.vercel.app
# Set this for multi-user deployments; omit for a single active personal session.
PBF_R1_MENTRA_USER_ID=
